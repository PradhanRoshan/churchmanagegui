{
  "name": "churchmanagegui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --open",
    "start:prod": "ng serve --configuration production",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:watch": "ng test --watch=true",
    "test:coverage": "ng test --watch=false --code-coverage",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier \"src/**/*.{ts,html,css,scss}\" --write",
    "format:check": "prettier \"src/**/*.{ts,html,css,scss}\" --check",
    "check:versions": "npx ng version",
    "analyze": "ng build --stats-json && webpack-bundle-analyzer dist/**/stats.json",
    "clean": "rimraf dist node_modules package-lock.json .angular && npm install"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.0",
    "@angular/common": "20.3.0",
    "@angular/compiler": "20.3.0",
    "@angular/core": "20.3.0",
    "@angular/forms": "20.3.0",
    "@angular/platform-browser": "20.3.0",
    "@angular/platform-browser-dynamic": "20.3.0",
    "@angular/router": "20.3.0",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.0",
    "@angular/cli": "20.3.0",
    "@angular/compiler-cli": "20.3.0",
    "@types/bootstrap": "^5.2.10",
    "@types/jasmine": "~5.1.0",
    "@angular-eslint/builder": "^20.0.0",
    "@angular-eslint/eslint-plugin": "^20.0.0",
    "@angular-eslint/eslint-plugin-template": "^20.0.0",
    "@angular-eslint/template-parser": "^20.0.0",
    "@angular-eslint/schematics": "^20.0.0",
    "eslint": "^9.23.0",
    "@typescript-eslint/parser": "^8.27.0",
    "@typescript-eslint/eslint-plugin": "^8.27.0",
    "jasmine-core": "~5.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "rimraf": "^6.0.1",
    "typescript": "5.8.3"
    
  }
}
